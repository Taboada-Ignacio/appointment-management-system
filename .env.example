# Configuración de Servidor Backend
SERVER_PORT=8080

# Configuración de Frontend
FRONTEND_PORT=5173

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=turnos_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Confirmaciones manuales (usar al menos 32 caracteres aleatorios en producción)
TURNOS_CONFIRMACION_SECRETO=replace_with_a_random_secret_of_at_least_32_chars
TURNOS_CONFIRMACION_VIGENCIA=PT5M


