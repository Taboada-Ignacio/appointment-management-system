# URL base del Backend API.
# Vacía en desarrollo para que las rutas /api usen el proxy same-origin de Vite.
# En producción puede ser una URL absoluta si el backend habilita CORS.
VITE_API_URL=

# --- Contexto profesional provisional ---
# Hasta que existan auth y perfil, estas variables identifican al profesional.
VITE_PROFESSIONAL_ID=1
VITE_PROFESSIONAL_NAME=Profesional
VITE_PROFESSIONAL_SPECIALTY=Medicina General
VITE_PROFESSIONAL_TIMEZONE=America/Argentina/Buenos_Aires
VITE_PROFESSIONAL_ACTOR=profesional
